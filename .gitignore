# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Data files (do not commit raw binary NetCDF files or local sqlite/parquet)
data/raw/*.nc
data/raw/*_prof.nc
data/processed/*.db
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
